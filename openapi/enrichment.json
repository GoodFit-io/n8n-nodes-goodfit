		"/enrichment/enrich-contact/request/{requestId}": {
			"get": {
				"operationId": "enrichment:getContactEnrichmentRequest",
				"summary": "Get a contact enrichment request",
				"description": "result is present once the request is COMPLETE, and error once it is ERROR.",
				"tags": [
					"Contact enrichment"
				],
				"security": [
					{
						"apiKey": [
							"CONTACT_ENRICHMENT_API"
						]
					}
				],
				"x-rate-limit-cost": 1,
				"parameters": [
					{
						"name": "requestId",
						"in": "path",
						"required": true,
						"schema": {
							"$schema": "https://json-schema.org/draft/2020-12/schema",
							"type": "string",
							"format": "uuid",
							"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Get a contact enrichment request",
						"content": {
							"application/json": {
								"schema": {
									"$schema": "https://json-schema.org/draft/2020-12/schema",
									"type": "object",
									"properties": {
										"requestId": {
											"type": "string",
											"format": "uuid",
											"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
										},
										"status": {
											"type": "string",
											"enum": [
												"QUEUED",
												"IN_PROGRESS",
												"ERROR",
												"COMPLETE"
											]
										},
										"error": {
											"type": "string"
										},
										"inputs": {
											"type": "object",
											"properties": {
												"selectedCandidateId": {
													"type": "string"
												},
												"linkedInUrl": {
													"type": "string"
												},
												"companyName": {
													"type": "string"
												},
												"companyDomain": {
													"type": "string"
												},
												"workEmail": {
													"type": "string"
												},
												"firstName": {
													"type": "string"
												},
												"lastName": {
													"type": "string"
												},
												"jobTitle": {
													"type": "string"
												},
												"selectedCompanyId": {
													"type": "string"
												}
											},
											"additionalProperties": false
										},
										"result": {
											"type": "object",
											"properties": {
												"found": {
													"type": "boolean"
												},
												"matchedBy": {
													"type": "string",
													"enum": [
														"linkedInUrl",
														"workEmail",
														"crmRecord",
														"name"
													]
												},
												"reason": {
													"type": "string",
													"enum": [
														"PERSON_NOT_FOUND",
														"MULTIPLE_EMPLOYMENTS_FOUND",
														"NO_COMPANY_MATCH",
														"NOT_ENOUGH_INFORMATION",
														"COMPANY_HAS_NO_DOMAIN",
														"COMPANY_RESOLUTION_CONFLICT",
														"CONTACT_RESOLUTION_CONFLICT",
														"CRM_RECORD_NOT_FOUND",
														"NAME_NOT_FOUND_AT_COMPANY",
														"COMPANY_DOMAIN_NOT_FOUND",
														"COMPANY_NAME_NOT_FOUND",
														"FORMER_EMPLOYEE",
														"MULTIPLE_PEOPLE_FOUND"
													],
													"description": "Why the contact was not added when `found` is false. A LinkedIn URL whose profile no longer exists returns `PERSON_NOT_FOUND`. Nothing is charged when `found` is false."
												},
												"employments": {
													"type": "array",
													"items": {
														"type": "object",
														"properties": {
															"companyId": {
																"type": "string"
															},
															"companyName": {
																"type": [
																	"string",
																	"null"
																]
															},
															"companyDomain": {
																"type": [
																	"string",
																	"null"
																]
															},
															"jobTitle": {
																"type": [
																	"string",
																	"null"
																]
															},
															"startDate": {
																"type": [
																	"string",
																	"null"
																]
															}
														},
														"required": [
															"companyId",
															"companyName",
															"companyDomain",
															"jobTitle",
															"startDate"
														],
														"additionalProperties": false
													}
												},
												"candidates": {
													"type": "array",
													"items": {
														"type": "object",
														"properties": {
															"candidateId": {
																"type": "string"
															},
															"firstName": {
																"type": [
																	"string",
																	"null"
																]
															},
															"lastName": {
																"type": [
																	"string",
																	"null"
																]
