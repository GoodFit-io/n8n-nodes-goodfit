		"/enrichment/enrich-contact/request/{requestId}/resolve": {
			"post": {
				"operationId": "enrichment:resolveContactEnrichmentRequest",
				"summary": "Pick a person or employment",
				"description": "Settles a COMPLETE contact enrichment that offered a choice: send selectedCandidateId for MULTIPLE_PEOPLE_FOUND, or selectedCompanyId for MULTIPLE_EMPLOYMENTS_FOUND. It enriches the one picked as a new request, with the original identity and options. Poll GET /enrich-contact/request/{requestId} with the returned id.",
