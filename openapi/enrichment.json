									"syncToCRM": {
										"default": false,
										"type": "boolean"
									}
								},
								"required": [
									"identity"
								]
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "The request is recorded and queued",
						"content": {
							"application/json": {
								"schema": {
									"$schema": "https://json-schema.org/draft/2020-12/schema",
									"type": "object",
									"properties": {
										"requestId": {
											"type": "string",
											"format": "uuid",
											"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
										},
										"status": {
											"type": "string",
											"enum": [
												"QUEUED",
												"IN_PROGRESS",
												"ERROR",
												"COMPLETE"
											]
										}
									},
									"required": [
										"requestId",
										"status"
									],
									"additionalProperties": false
								}
							}
						}
					},
					"400": {
						"description": "No LinkedIn URL, work email, or first name + last name + company was given, a field is malformed, selectedCandidateId was not offered for this contact, or an external id names a CRM that is not connected",
