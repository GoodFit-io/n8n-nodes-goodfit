{
	"openapi": "3.1.0",
	"info": {
		"title": "Goodfit Enrichment API",
		"version": "1.0.0",
		"description": "Add companies to your Goodfit dataset by domain, and contacts by LinkedIn URL, work email, or name and company, and check how each request resolved."
	},
	"servers": [
		{
			"url": "https://api.goodfit.io"
		}
	],
	"tags": [
		{
			"name": "Company enrichment",
			"x-page-title": "Company endpoints"
		},
		{
			"name": "Contact enrichment",
			"x-page-title": "Contact endpoints"
		}
	],
	"components": {
		"securitySchemes": {
			"apiKey": {
				"type": "apiKey",
				"in": "header",
				"name": "Authorization",
				"description": "Your Goodfit API key, sent as the bare header value"
			}
		}
	},
	"security": [
		{
			"apiKey": []
		}
	],
	"paths": {
		"/enrichment/enrich": {
			"post": {
				"operationId": "enrichment:enrichCompany",
				"summary": "Enrich a company",
				"description": "Adds the company to your Goodfit dataset asynchronously. A company new to your dataset appears within minutes with its name, domain and LinkedIn URL, and its data points, scores and tags normally follow within minutes; segments arrive with your next daily dataset update. Poll GET /request/{requestId} with the returned id to see how the request resolved and, through dataStatus, when the company is filled in.",
				"tags": [
					"Company enrichment"
				],
				"security": [
					{
						"apiKey": [
							"ENRICHMENT_API"
						]
					}
				],
				"x-rate-limit-cost": 1,
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$schema": "https://json-schema.org/draft/2020-12/schema",
								"type": "object",
								"properties": {
									"domain": {
										"type": "string",
										"minLength": 1
									},
									"email": {
										"description": "Used only to derive a domain. Personal providers rejected",
										"type": "string",
										"format": "email",
										"pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
									},
									"externalIds": {
										"type": "object",
										"properties": {
											"salesforce": {
												"type": "string"
											},
											"hubspot": {
												"type": [
													"string",
													"number"
												]
											}
										}
									},
									"forceOverrideExternalIds": {
										"type": "boolean"
									},
									"syncToCRM": {
										"description": "Write the company to every connected CRM once its data points, scores and tags are filled in, or at once if it already is. Defaults to false",
										"type": "boolean"
									}
								}
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "The request is recorded and queued",
						"content": {
							"application/json": {
								"schema": {
									"$schema": "https://json-schema.org/draft/2020-12/schema",
									"type": "object",
									"properties": {
										"success": {
											"type": "boolean",
											"const": true
										},
										"requestId": {
											"type": "string",
											"format": "uuid",
											"pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
										}
									},
									"required": [
										"success",
										"requestId"
									],
									"additionalProperties": false
								}
							}
						}
					},
					"400": {
						"description": "Neither a domain nor an email was given, or neither yields a business domain",
						"content": {
							"application/json": {
								"schema": {
									"$schema": "https://json-schema.org/draft/2020-12/schema",
									"type": "object",
									"properties": {
										"error": {
											"type": "string",
											"description": "Human readable. Wording may change between releases"
										},
										"code": {
											"type": "string",
											"enum": [
												"INVALID_REQUEST"
											],
											"description": "Stable identifier. Match on this rather than on `error`"
										}
									},
									"required": [
										"error",
										"code"
									],
									"additionalProperties": false
								}
							}
						}
					},
					"401": {
						"description": "Unauthorized",
						"content": {
							"application/json": {
								"schema": {
									"$schema": "https://json-schema.org/draft/2020-12/schema",
									"type": "object",
									"properties": {
										"error": {
											"type": "string",
											"description": "Human readable. Wording may change between releases"
										},
										"code": {
											"type": "string",
											"enum": [
												"UNAUTHENTICATED"
											],
											"description": "Stable identifier. Match on this rather than on `error`"
										}
									},
									"required": [
										"error",
										"code"
									],
									"additionalProperties": false
								}
							}
						}
					},
					"403": {
						"description": "Forbidden",
						"content": {
							"application/json": {
								"schema": {
									"$schema": "https://json-schema.org/draft/2020-12/schema",
									"type": "object",
									"properties": {
										"error": {
											"type": "string",
											"description": "Human readable. Wording may change between releases"
										},
										"code": {
											"type": "string",
											"enum": [
												"FORBIDDEN"
											],
											"description": "Stable identifier. Match on this rather than on `error`"
										}
									},
									"required": [
										"error",
										"code"
									],
									"additionalProperties": false
								}
							}
						}
					},
					"429": {
						"description": "Too many requests",
						"headers": {
							"Retry-After": {
								"description": "Seconds to wait before retrying",
								"schema": {
									"type": "integer"
								}
							}
						},
						"content": {
							"application/json": {
								"schema": {
									"$schema": "https://json-schema.org/draft/2020-12/schema",
									"type": "object",
									"properties": {
										"error": {
											"type": "string",
											"description": "Human readable. Wording may change between releases"
										},
										"code": {
											"type": "string",
											"enum": [
												"RATE_LIMITED"
											],
											"description": "Stable identifier. Match on this rather than on `error`"
										}
									},
									"required": [
										"error",
										"code"
									],
									"additionalProperties": false
								}
							}
						}
					},
					"500": {
						"description": "Internal server error",
						"content": {
							"application/json": {
								"schema": {
									"$schema": "https://json-schema.org/draft/2020-12/schema",
									"type": "object",
									"properties": {
										"error": {
											"type": "string",
											"description": "Human readable. Wording may change between releases"
										},
										"code": {
											"type": "string",
											"enum": [
												"INTERNAL_ERROR"
											],
											"description": "Stable identifier. Match on this rather than on `error`"
										}
									},
									"required": [
										"error",
										"code"
									],
									"additionalProperties": false
								}
							}
						}
					}
				}
			}
		},
		"/enrichment/enrich-contact/request": {
			"post": {
				"operationId": "enrichment:enrichContact",
