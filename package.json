{
	"name": "n8n-nodes-goodfit",
	"version": "0.1.2",
	"description": "n8n nodes for GoodFit: enrich companies and contacts, read your GoodFit dataset, and trigger workflows from GoodFit syncs",
	"license": "MIT",
	"homepage": "https://github.com/GoodFit-io/n8n-nodes-goodfit",
	"keywords": [
		"n8n-community-node-package",
		"goodfit",
		"enrichment",
		"sales",
		"crm"
	],
	"author": {
		"name": "GoodFit",
		"email": "integrations@goodfit.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/GoodFit-io/n8n-nodes-goodfit.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"prepublishOnly": "n8n-node prerelease",
		"test": "vitest run",
		"openapi:sync": "node scripts/sync-openapi.mjs",
		"openapi:check": "node scripts/sync-openapi.mjs --check",
		"typecheck": "tsc -p tsconfig.test.json",
		"local": "scripts/local-n8n.sh",
		"local:examples": "scripts/import-examples.sh"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/GoodFitApi.credentials.js",
			"dist/credentials/GoodFitWebhookApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/GoodFit/GoodFit.node.js",
			"dist/nodes/GoodFitTrigger/GoodFitTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.54.5",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"eslint": "9.39.4",
		"prettier": "3.9.10",
		"typescript": "5.9.3",
		"vitest": "^5.0.4"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
